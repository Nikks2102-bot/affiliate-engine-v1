{
  "name": "affiliate-engine-v1",
  "version": "2.0.0",
  "private": true,
  "description": "Hybrid affiliate engine: Cloudflare edge gateway + Railway core + PostgreSQL.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:railway": "tsc --outDir dist --module CommonJS --target ES2022 --moduleResolution Node --esModuleInterop --skipLibCheck",
    "start:railway": "node dist/railway.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.44.0"
  }
}
