{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "affiliate-engine-v1",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affiliate-engine-db",
      "database_id": "75ec8dfc-ebf4-4dd7-90c9-816faa3e5966"
    }
  ],
  "vars": {
    "BANKROLL_CENTS": "200000",
    "MAX_DAILY_SPEND_CENTS": "50000",
    "MAX_TOTAL_LOSS_CENTS": "200000",
    "AUTOMATION_MODE": "approval_required"
  }
}
